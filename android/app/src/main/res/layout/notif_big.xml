<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notif_bg"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="MIS CUENTAS · ESTE MES" android:textColor="#3EE6A8" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:id="@+id/n_main" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#EEF1F4" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/n_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#8B93A1" android:textSize="13sp" android:maxLines="3" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
        <ProgressBar
            android:id="@+id/n_bar_ok"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="visible"
            android:progressDrawable="@drawable/prog_ok" />
        <ProgressBar
            android:id="@+id/n_bar_warn"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressDrawable="@drawable/prog_warn" />
        <ProgressBar
            android:id="@+id/n_bar_bad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressDrawable="@drawable/prog_bad" />
    </LinearLayout>
    <TextView android:id="@+id/n_pct" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="end" android:textColor="#5D6470" android:textSize="11sp" />
</LinearLayout>
